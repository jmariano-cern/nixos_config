#!/run/current-system/sw/bin/bash

# for alias expansion
shopt -s extglob

##############################
#                            #
#       user variables       #
#                            #
##############################

# command aliases
ALIAS_CLIP="clip|cl|c"
ALIAS_INDEX="index|in|i|list|li"
ALIAS_GENERATE="generate|gen|ge|g"
ALIAS_ADD="add|ad|a"
ALIAS_SHOW="show|sh|s"
ALIAS_DELETE="delete|del|de|d|rm"
ALIAS_HELP="help|he|h"
ALIAS_BACKUP="backup|back|bak|ba|b"
ALIAS_LOAD="load"
ALIAS_MERGE="merge|mer|me|m"
ALIAS_INITIALIZE="initialize|init"
ALIAS_UNLOCK="unlock|unl|un|u"
ALIAS_LOCK="lock|lo"
ALIAS_NOTE="note|no"
ALIAS_NINDEX="nindex|nind|nin|ni|nlist|nl"
ALIAS_NDELETE="ndelete|ndel|nd"
ALIAS_NSHOW="nshow|nsh|ns"
ALIAS_RANDOM="random|rand|ran|ra|r"
ALIAS_SOURCECODE="sourcecode"

# home directory
DEFAULT_HOME_DIR="${HOME}/.upm_home"
PASSWORD_DIR_NAME=".passwords"
INDEX_DIR_NAME=".index"
NOTE_DIR_NAME=".notes"
NOTE_INDEX_DIR_NAME=".notes_index"
HASH_SIZE="1"

# gpg settings
KEY_TYPE="RSA"
KEY_LENGTH=4096
KEY_NAME="upm"
KEY_EXPIRY=0
GPG_KEY_ID_FILE_NAME=".gpg_key_id"
GPG_HOME_DIR_NAME=".gpg_home"
GPG_UNLOCK_FILE_NAME=".gpg_unlock"
GPG_UNLOCK_FILE_CONTENTS='upm unlocked.'
LOCK_TIME=0
UNLOCK_TIME=31425292
GPG_CONF_FILE_NAME="gpg-agent.conf"

# password generation
DEFAULT_CHAR_SET="print"
DEFAULT_LENGTH_CHAR=64
VALID_CHARSETS=( \
    "alnum"
    "alpha"
    "digit"
    "graph"
    "lower"
    "print"
    "punct"
    "upper"
    "xdigit"
    )
    
# clip
CLIP_TIMEOUT_SECONDS=10
#DEFAULT_CLIP_COMMAND='wl-copy -o'
DEFAULT_CLIP_COMMAND='xsel -t 60000'

# notes
NOTE_BUFFER_NAME=".notes_buffer"
DEFAULT_EDITOR="emacs -nw"

# backup
DEFAULT_BACKUP_FILE='$(dirname ${HOME_DIR})/upm_backup_$(date +%y-%m-%d_%H-%M-%S).tar.bz2'

# random
RANDOM_DEFAULT_LENGTH=64
RANDOM_DEFAULT_NUM=1
RANDOM_DEFAULT_CHARSET="print"

# help formatiing
INDENT_SIZE=5
BUFFER_SIZE=2
SEPARATOR="-- "
OPT_TAG="*"
VSPACING=2
DESCRIPTION_TAG="-"
FRAME_CHAR="#"
FRAME_HPAD=2
FRAME_VPAD=1
HEADER_STRING="upm: micro password manager"
ALIASES_HEADER="Aliases:"
PARAMETERS_HEADER="Parameters:"
DESCRIPTION_HEADER="Command description:"
USAGE_HEADER="Usage examples:"

##############################
#                            #
#    initialize variables    #
#                            #
##############################

HOME_DIR="${UPM_HOME:-${DEFAULT_HOME_DIR}}"
PASSWORD_DIR="${HOME_DIR}/${PASSWORD_DIR_NAME}"
INDEX_DIR="${HOME_DIR}/${INDEX_DIR_NAME}"
NOTE_DIR="${HOME_DIR}/${NOTE_DIR_NAME}"
NOTE_INDEX_DIR="${HOME_DIR}/${NOTE_INDEX_DIR_NAME}"
GPG_KEY_ID_FILE="${HOME_DIR}/${GPG_KEY_ID_FILE_NAME}"
GPG_HOME_DIR="${HOME_DIR}/${GPG_HOME_DIR_NAME}"
CLIP_COMMAND="${UPM_CLIP_COMMAND:-${DEFAULT_CLIP_COMMAND}}"
DEFAULT_BACKUP_FILE=$(eval printf \'%s\' \"${DEFAULT_BACKUP_FILE}\")
GPG_UNLOCK_FILE="${GPG_HOME_DIR}/${GPG_UNLOCK_FILE_NAME}"
GPG_CONF_FILE="${GPG_HOME_DIR}/${GPG_CONF_FILE_NAME}"
NOTE_BUFFER="${NOTE_DIR}/${NOTE_BUFFER_NAME}"
EDITOR="${UPM_EDITOR:-${DEFAULT_EDITOR}}"

##############################
#                            #
#         utilties           #
#                            #
##############################

# hash_string string
hash_string() {
    printf '%s' "${1}" | "sha${HASH_SIZE}sum" | awk '{print $1}'
}

# verify_entry_ne scope username
verify_entry_ne() {
    if [ -e "${PASSWORD_DIR}/$(hash_string ${1})/$(hash_string ${2})" ]
    then
	error "Entry ${1} ${2} already exists.
     Delete it first using 'upm delete ${1} ${2}'."
    fi
}

# verify_entry_e scope username
verify_entry_e() {
    if [ ! -e "${PASSWORD_DIR}/$(hash_string ${1})/$(hash_string ${2})" ]
    then
	error "Entry ${1} ${2} does not exist."
    fi
}

# get_lockstate
get_lockstate() {
    if [ "$(head -n 1 ${GPG_CONF_FILE} | awk '{ print $2 }')" == "${LOCK_TIME}" ]
    then
	printf '%u' 1
    else
	printf '%u' 0
    fi
}

# check_int int name
check_int() {
    if [ ! "${2}" == "" ]
    then
	case ${2} in
	    ''|*[!0-9]*) error "Invalid ${1}: ${2}";;
	esac
    fi    
}

##############################
#                            #
#           notes            #
#                            #
##############################

# verify_note_e title
verify_note_e() {
    if [ ! -e "${NOTE_DIR}/$(hash_string ${1})" ]
    then
	error "Note: ${1} does not exist."
    fi
}

# init_notes
init_notes() {
    mkdir ${NOTE_DIR}
    mkdir ${NOTE_INDEX_DIR}
}

# add_to_note_index title
add_to_note_index() { 
    set_gpg_recipient
    printf '%s\n' "${1}" | 
	gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output "${NOTE_INDEX_DIR}/$(hash_string ${1})"
    printf '%s\n' "Note: ${1} created."
}

# remove_from_note_index title
remove_from_note_index() {
    rm -f "${NOTE_INDEX_DIR}/$(hash_string ${1})"
    printf '%s\n' "Note: ${1} deleted."
}

# nindex
nindex() { 
    set_gpg_recipient
    lockstate=$(get_lockstate)
    if [ "${lockstate}" -eq 1 ]
    then
	unlock
    fi
    printf '%s\n' "######################"
    printf '%s\n' "Index of stored notes:"
    printf '%s\n' "######################"
    for title in ${NOTE_INDEX_DIR}/*
    do
	gpg --quiet --recipient ${GPG_RECIPIENT} --decrypt ${title}
    done
    printf '%s\n' "######################"
    if [ "${lockstate}" -eq 1 ]
    then
	lock
    fi
}

# ndelete title
ndelete() {
    verify_note_e ${1}
    printf '%s\n' "Are you sure that you want to delete note: ${1}"
    printf '%s' "     Type 'yes' to confirm: "
    read -r "confirm"
    if [ "${confirm}" == "yes" ]
    then
	rm -f "${NOTE_DIR}/$(hash_string ${1})"
	remove_from_note_index ${1}
    else
	printf '%s\n' "Note deletion for ${1} aborted."
    fi
}

# nshow title
nshow() {
    set_gpg_recipient
    verify_note_e ${1}
    gpg --quiet --recipient ${GPG_RECIPIENT} --decrypt "${NOTE_DIR}/$(hash_string ${1})"
}

# note title
note() {
    set_gpg_recipient
    if [ -e "${NOTE_DIR}/$(hash_string ${1})" ]
    then
	gpg --quiet --recipient ${GPG_RECIPIENT} --decrypt --output ${NOTE_BUFFER} "${NOTE_DIR}/$(hash_string ${1})"
	${EDITOR} ${NOTE_BUFFER}
	gpg --quiet --yes --recipient ${GPG_RECIPIENT} --encrypt --output "${NOTE_DIR}/$(hash_string ${1})" ${NOTE_BUFFER}
	printf '%s\n' "Note: ${1} saved."
    else
	touch ${NOTE_BUFFER}
	${EDITOR} ${NOTE_BUFFER}
	if [ $(du ${NOTE_BUFFER} | awk '{ print $1}') -gt 0 ]
	then
	    gpg --quiet --yes --recipient ${GPG_RECIPIENT} --encrypt --output "${NOTE_DIR}/$(hash_string ${1})" ${NOTE_BUFFER}
	    add_to_note_index ${1}
	else
	    error "Refusing to save empty note."
	fi
    fi
    shred -z ${NOTE_BUFFER}
    rm ${NOTE_BUFFER}
    shred -z ${NOTE_BUFFER}~ > /dev/null 2>&1
    rm ${NOTE_BUFFER}~ > /dev/null 2>&1
}

##############################
#                            #
#           index            #
#                            #
##############################

# add_to_index scope username
add_to_index() { 
    set_gpg_recipient
    mkdir -p "${INDEX_DIR}/$(hash_string ${1})"
    printf '%s\n' "${1} ${2}" | 
	gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output "${INDEX_DIR}/$(hash_string ${1})/$(hash_string ${2})"
    printf '%s\n' "Password added for ${1} ${2}"
}

# remove_from_index scope username
remove_from_index() {
    rm -f "${INDEX_DIR}/$(hash_string ${1})/$(hash_string ${2})"
    rmdir --ignore-fail-on-non-empty "${INDEX_DIR}/$(hash_string ${1})"
    printf '%s\n' "Password for ${1} ${2} deleted."
}

# index
index() {
    set_gpg_recipient
    lockstate=$(get_lockstate)
    if [ "${lockstate}" -eq 1 ]
    then
	unlock
    fi
    printf '%s\n' "##########################"
    printf '%s\n' "Index of stored passwords:"
    printf '%s\n' "##########################"
    for scope in ${INDEX_DIR}/*
    do
	for username in ${scope}/*
	do
	    gpg --quiet --recipient ${GPG_RECIPIENT} --decrypt ${username} | tr ":" " "
	done
    done
    printf '%s\n' "##########################"
    if [ "${lockstate}" -eq 1 ]
    then
	lock
    fi
}

##############################
#                            #
#            add             #
#                            #
##############################

# add scope username
add() {
    set_gpg_recipient
    verify_entry_ne "${1}" "${2}"
    mkdir -p "${PASSWORD_DIR}/$(hash_string ${1})"
    export IFS=
    printf '%s' "Enter password: "
    # quiet typing
    stty -echo
    read -r "password"
    printf '\n'
    printf '%s' "Re-enter password: "
    read -r "password_confirm"
    # regular typing
    stty echo
    if [ "${password}" != "${password_confirm}" ];
    then
	error "Passwords did not match."
    fi
    unset IFS
    printf '%s\n' "${password}" |    
	gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output "${PASSWORD_DIR}/$(hash_string ${1})/$(hash_string ${2})"
    unset password
    add_to_index "${1}" "${2}"
}

##############################
#                            #
#           random           #
#                            #
##############################

# generate_random length num char_set
generate_random() {
    cat /dev/urandom | tr -cd [:"${3:-${RANDOM_DEFAULT_CHARSET}}":] | fold -w "${1:-${RANDOM_DEFAULT_LENGTH}}" | head -n ${2:-${RANDOM_DEFAULT_NUM}}
}

# random length num_chars num
random() {
    check_int "length" ${1}
    check_int "num" ${2}
    check_charset ${3}
    generate_random ${1} ${2} ${3}
}


##############################
#                            #
#         generate           #
#                            #
##############################

# check_charset charset
check_charset() {
    if [ ! "${1}" == "" ]
    then
	if [[ ! " ${VALID_CHARSETS[@]} " =~ " ${1} " ]]
	then
	    error "Invalid charset ${1}."
	fi
    fi
}

# generate_string num_chars char_set
generate_string() {
    cat /dev/urandom | tr -cd [:"${2:-${DEFAULT_CHAR_SET}}":] | fold -w "${1:-${DEFAULT_LENGTH_CHAR}}" | head -n 1
}

# generate scope username num_chars char_set
generate() {
    check_int "num_chars" ${3}
    check_charset ${4}
    set_gpg_recipient
    verify_entry_ne "${1}" "${2}"
    mkdir -p "${PASSWORD_DIR}/$(hash_string ${1})"
    generate_string "${3}" "${4}" |
	    gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output "${PASSWORD_DIR}/$(hash_string ${1})/$(hash_string ${2})"
    add_to_index "${1}" "${2}"
}

##############################
#                            #
#             gpg            #
#                            #
##############################

# gpg_agent_restart
gpg_agent_restart() {
    gpg-connect-agent reloadagent /bye > /dev/null 2>&1
}

# init_gpg_unlock_file
init_gpg_unlock_file() {
    set_gpg_recipient
    printf '%s\n' "${GPG_UNLOCK_FILE_CONTENTS}" | gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output ${GPG_UNLOCK_FILE}
}

# init_lock
init_lock() {
    printf '%s\n%s\n%s\n' "default-cache-ttl ${LOCK_TIME}" "max-cache-ttl ${LOCK_TIME}" "pinentry-program /run/current-system/sw/bin/pinentry-tty" > ${GPG_CONF_FILE}
    gpg_agent_restart
    printf '%s\n' "upm locked."
}

# unlock
unlock() {
    lockstate=$(get_lockstate)
    #if [ "${lockstate}" == 0 ]
    #then
	#error "upm is already unlocked."
    #fi
    set_gpg_recipient
    printf '%s\n%s\n%s\n' "default-cache-ttl ${UNLOCK_TIME}" "max-cache-ttl ${UNLOCK_TIME}" "pinentry-program /run/current-system/sw/bin/pinentry-tty" > ${GPG_CONF_FILE}
    gpg_agent_restart
    gpg --quiet --recipient ${GPG_RECIPIENT} --decrypt "${GPG_UNLOCK_FILE}"
}

# lock
lock() {
    lockstate=$(get_lockstate)
    #if [ "${lockstate}" == 1 ]
    #then
	#error "upm is already locked."
    #fi
    printf '%s\n%s\n' "default-cache%s\n-ttl ${LOCK_TIME}" "max-cache-ttl ${LOCK_TIME}" "pinentry-program /run/current-system/sw/bin/pinentry-tty"> ${GPG_CONF_FILE}
    gpg_agent_restart
    printf '%s\n' "upm locked."
}

# init_gpg
init_gpg() {
    printf '%s' "Enter password: "
    # quiet typing
    stty -echo
    read -r "password"
    printf '%s\n'
    printf '%s' "Re-enter password: "
    read -r "password_confirm"
    # regular typing
    stty echo
    if [ "${password}" != "${password_confirm}" ];
    then
	error "Passwords did not match."
    fi
    # note -p means this will create ${HOME_DIR} as well
    mkdir -p $GNUPGHOME
    chmod 700 $GNUPGHOME
    keygen_file=$(mktemp)
    (cat >${keygen_file} <<EOF && printf '\n' && printf '%s\n' "Generating keys. This may take some time..." && gpg --batch --generate-key ${keygen_file} |& awk '/openpgp-revocs.d\//' | awk -F'openpgp-revocs.d/' '{print $NF}' | awk -F'.rev' '{print $1}' > ${GPG_KEY_ID_FILE}); shred -z ${keygen_file}; rm -f ${keygen_file}
    Key-Type: ${KEY_TYPE}
    Key-Length: ${KEY_LENGTH}
    Name-Real: ${KEY_NAME}
    Expire-Date: ${KEY_EXPIRY}
    Passphrase: ${password}
EOF
    unset password
}

# swap_gpg_home
swap_gpg_home() {
    export GNUPGHOME_BUFFER=${GNUPGHOME}
    export GNUPGHOME=${GPG_HOME_DIR}
}

# revert_gpg_home
revert_gpg_home() {
    export GNUPGHOME=${GNUPGHOME_BUFFER}
}

# get_gpg_key_id
set_gpg_recipient() {
    GPG_RECIPIENT=$(cat ${GPG_KEY_ID_FILE})
}

##############################
#                            #
#            init            #
#                            #
##############################

# check_init
check_init() {
    if [ -e "${GPG_KEY_ID_FILE}" ]
    then
	error "upm has already been initialized with home directory at ${HOME_DIR}"
    fi
}

# initialize
initialize() {
    check_init
    init_gpg
    init_gpg_unlock_file
    init_notes
    init_lock
}

##############################
#                            #
#          delete            #
#                            #
##############################

# delete scope username
delete() {
    verify_entry_e ${1} ${2}
    printf '%s\n' "Are you sure that you want to delete the password for ${1} ${2}?"
    printf '%s' "     Type 'yes' to confirm: "
    read -r "confirm"
    if [ "${confirm}" == "yes" ]
    then
	rm -f "${PASSWORD_DIR}/$(hash_string ${1})/$(hash_string ${2})"
	rmdir --ignore-fail-on-non-empty "${PASSWORD_DIR}/$(hash_string ${1})"
	remove_from_index ${1} ${2}
    else
	printf '%s\n' "Password deletion for ${1} ${2} aborted."
    fi
}

##############################
#                            #
#           show             #
#                            #
##############################

# show scope username
show() {
    set_gpg_recipient
    verify_entry_e "${1}" "${2}"
    gpg --quiet --recipient ${GPG_RECIPIENT} --decrypt "${PASSWORD_DIR}/$(hash_string ${1})/$(hash_string ${2})"
}

##############################
#                            #
#           clip             #
#                            #
##############################

# clip scope username seconds
clip() {
    check_int "time" ${3}
    time=$((${3:-${CLIP_TIMEOUT_SECONDS}}*1000))
    verify_entry_e "${1}" "${2}"
    show "${1}" "${2}" | tr -d '\n' | $(eval printf \'%s\' \"${CLIP_COMMAND}\")
    #printf '%s\n' "Password for ${1} ${2} copied to the clipboard for ${3:-${CLIP_TIMEOUT_SECONDS}} seconds."
    printf '%s\n' "Password for ${1} ${2} copied to the clipboard (single-paste only)."
}

