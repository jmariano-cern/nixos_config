#                            #
#           info             #
#                            #
##############################

# error message
error() {
    printf '%s\n' "ERROR: $1"
    exit
}

# print_args_info
print_args_info() {
    printf '%s\n' "----------------------------------------------- "
    printf '\n'
    printf '%s\n' "A brief explanation of the 'Parameters' section:"
    printf '\n'
    printf '%s\n' "-Arguments must be entered in the order given."
    printf '%s\n' "-Optional arguments are prefaced by an asterix (*)."
    printf '%s\n' "-Optional arguments are followed by their default value in parenthesis."
    printf '%s\n' "-If a command takes no arguments, the argument list will be blank."
    printf '%s\n' "-When referenced in the command description arguments will appear in <angle braces>."
    printf '\n'
    printf '%s\n' "----------------------------------------------- "
}

# print_footer
print_footer() {
    printf '%s\n' "     Provided under the GPL."
    printf '%s\n' "     Coded by Joseph Mariano"
    printf '%s\n' "          (joseph.mariano@cern.ch)"
}

# help_general
help_general() {
    print_frame ${FRAME_CHAR} ${FRAME_HPAD} ${FRAME_VPAD} ${HEADER_STRING}
    printf '\n%.0s' $(seq 1 ${VSPACING})
    printf '%s\n' "For more information about a command use:"
    printf '%s\n' "     upm help <command>"
    printf '\n%.0s' $(seq 1 ${VSPACING})
    printf '%s\n' "Available commands:"
    printf '%s\n' "     initialize  --initialize a new instance of upm"
    printf '%s\n' "     generate    --randomly generate a new password"
    printf '%s\n' "     add         --add a new user defined password"
    printf '%s\n' "     index       --print index of stored passwords"
    printf '%s\n' "     show        --display a password"
    printf '%s\n' "     clip        --copy a password to the clipboard"
    printf '%s\n' "     unlock      --unlock upm"
    printf '%s\n' "     lock        --lock upm"
    printf '%s\n' "     delete      --delete a stored password"
    printf '%s\n' "     note        --create or edit a note"
    printf '%s\n' "     nindex      --print index of notes"
    printf '%s\n' "     nshow       --display a note"
    printf '%s\n' "     ndelete     --delete a note"
    printf '%s\n' "     random      --generate random strings"
    printf '%s\n' "     backup      --create a backup of stored passwords"
    printf '%s\n' "     load        --load a backup of stored passwords"
    printf '%s\n' "     merge       --merge a backup into current upm instance"
    printf '%s\n' "     help        --print command usage"
    printf '\n%.0s' $(seq 1 ${VSPACING})
    printf '%s\n' "--------------------------------------------------------"
    printf '\n'
    printf '%s\n' "Dependencies:"
    printf '\n'
    printf '%s\n' "     emacs  -- The 'note' command uses an editor to edit encrypted notes. The default editor is 'emacs-nox'. See 'help note' for more information about how to use other editors."
    printf '\n'
    printf '%s\n' "     gpg    -- upm uses gpg to encrypt and decrypt passwords and indices. Thus gpg is necessary to use upm. gpg version 2.1 is required in order for the lock and unlock functions to work as intended, although most functionality will likely be intact on earlier versions."
    printf '\n'
    printf '%s\n' "     xsel   -- The 'clip' command requires a cli based clipboard program to work. The default program is xsel. See 'help clip' for more information about how to use upm with a different program."
    printf '\n'
    printf '%s\n' "--------------------------------------------------------"
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_footer
}


# get_array_length array 
get_array_length() {
    array=(${@})
    printf '%u' ${#array[@]}
}

# get_array_max_length array 
get_array_max_length() {
    element_max_length=0
    for element in ${@}
    do
	if [ "${#element}" -gt "${element_max_length}" ]
	then
	    element_max_length=${#element}
	fi
    done
    printf '%s' ${element_max_length}
}

# print_nchar char ntimes
print_nchar() {
    printf "%${2}s" | tr " " "${1}"
}

# get_string_length string
get_string_length() {
    string=${@}
    printf '%s' "${#string}"
}

# print_frame frame_char pad vpad string
print_frame() {
    string=${@:4}
    length=$(get_string_length ${string})
    print_nchar ${1} $((${length}+2*${2}+2))
    printf '\n'
    i=0
    while [ "${i}" -lt "${3}" ]
    do
	printf '%s' "${1}"
	print_nchar " " $((${length}+2*${2}))
	printf '%s' "${1}"
	printf '\n'
	i=$((${i}+1))
    done
    printf '%s' "${1}"
    print_nchar " " ${2}
    printf '%s' "${string}"
    print_nchar " " ${2}
    printf '%s' "${1}"
    printf '\n'
    i=0
    while [ "${i}" -lt "${3}" ]
    do
	printf '%s' "${1}"
	print_nchar " " $((${length}+2*${2}))
	printf '%s' "${1}"
	printf '\n'
	i=$((${i}+1))
    done
    print_nchar ${1} $((${length}+2*${2}+2))
    printf '\n'
}

# print_center string width
print_center() {
    diff=$((${2}-${#1}))
    lpad=$((${diff}/2))
    print_nchar " " ${lpad}
    printf '%s\n' "${1}"
}

# print_aliases command
print_aliases() {
    alias_name="\${ALIAS_${1^^}}"
    alias_string=$(eval printf \'%s\' \"${alias_name}\")
    export IFS='|'
    read -r -a alias_array <<< "${alias_string}"
    unset IFS
    printf '%s\n' "${ALIASES_HEADER}"
    indent=$(printf ' %.0s' $(seq 1 ${INDENT_SIZE}))
    for alias in ${alias_array[@]}
    do
	printf '%s%s\n' "${indent}" "${alias}"
    done
}

# interleave array1 array2
interleave() {
    nel=$((${#@}/2))
    a1=(${@:1:$((${nel}))})
    a2=(${@:$((${nel}+1))})
    i=0
    while  [ "${i}" -lt "${nel}" ]
    do
	printf '%s%s%s%s\n' "${a1[${i}]}" " (" "${a2[${i}]}" ")"
	i=$((${i}+1))
    done
}

# interleave_max array1 array2
interleave_max() {
    nel=$((${#@}/2))
    a1=(${@:1:$((${nel}))})
    a2=(${@:$((${nel}+1))})
    max=0
    i=0
    while  [ "${i}" -lt "${nel}" ]
    do
	x1=${a1[${i}]}
	x2=${a2[${i}]}
	l1=${#x1}
	l2=${#x2}
	l=$((${l1}+${l2}+3))
	if [ "${l}" -gt "${max}" ]
	then
	    max=${l}
	fi
	i=$((${i}+1))
    done
    printf '%s' "${max}"
}

# interleave_length elnum array1 array2
interleave_length() {
    nel=$(($((${#@}-1))/2))
    a1=(${@:2:$((${nel}))})
    a2=(${@:$((${nel}+2))})
    nel=${1}
    x1=${a1[${nel}]}
    x2=${a2[${nel}]}
    l1=${#x1}
    l2=${#x2}
    l=$((${l1}+${l2}+3))
    printf '%s' "${l}"
}

# get_max in1 in2
get_max() {
    if [ "${2}" -gt "${1}" ]
    then
	printf '%u' ${2}
    else
	printf '%u' ${1}
    fi
}

# print_parameters command
print_parameters() {
    printf '%s\n' "${PARAMETERS_HEADER}"    

    v_par=($(help_${command} 'vital_parameters'))
    v_descr=$(help_${command} 'vital_parameters_descriptions')
    export IFS=$'\n'
    readarray -t v_descr <<< "${v_descr}"
    unset IFS
    v_num=$(get_array_length ${v_par[@]})
    v_max=$(get_array_max_length ${v_par[@]})

    o_par=($(help_${command} 'opt_parameters'))
    o_descr=$(help_${command} 'opt_parameters_descriptions')
    export IFS=$'\n'
    readarray -t o_descr <<< "${o_descr}"
    unset IFS
    o_def=($(help_${command} 'opt_parameters_defaults'))
    export IFS=$'\n'
    readarray -t o_full <<< "$(interleave ${o_par[@]} ${o_def[@]})"
    unset IFS
    o_num=$(get_array_length ${o_par[@]})
    o_max=$(interleave_max ${o_par[@]} ${o_def[@]})
    
    max_length=$(get_max ${v_max} ${o_max})

    v_indent=$(printf ' %.0s' $(seq 1 ${INDENT_SIZE}))
    i=0
    while [ "${i}" -lt "${v_num}" ]
    do
	element_length=${#v_par[${i}]}
	padding_size=$((${max_length}+${BUFFER_SIZE}-${element_length}))
	padding=$(printf ' %.0s' $(seq 1 ${padding_size}))
	printf '%s%s%s%s%s\n' "${v_indent}" "${v_par[${i}]}" "${padding}" "${SEPARATOR}" "$(printf '%s' "${v_descr[${i}]}" | awk '{$1=$1}1')"
	i=$((${i}+1))
    done

    o_indent_size=$((${INDENT_SIZE}-${#OPT_TAG}))
    o_indent=$(printf ' %.0s' $(seq 1 ${o_indent_size}))
    i=0
    while [ "${i}" -lt "${o_num}" ]
    do
	element_length=$(interleave_length ${i} ${o_par[@]} ${o_def[@]})
	padding_size=$((${max_length}+${BUFFER_SIZE}-${element_length}))
	padding=$(printf ' %.0s' $(seq 1 ${padding_size}))
	printf '%s%s%s%s%s%s%s%s%s\n' "${o_indent}" "${OPT_TAG}" "${o_par[${i}]}" " (" "${o_def[${i}]}" ")" "${padding}" "${SEPARATOR}" "$(printf '%s' "${o_descr[${i}]}" | awk '{$1=$1}1')"
	i=$((${i}+1))
    done
}

# print_description command
print_description() {
    printf '%s\n' "${DESCRIPTION_HEADER}"        

    descr=$(help_${command} 'command_description')
    export IFS=$'\n'
    readarray -t descr <<< "${descr}"
    unset IFS
    length=${#descr[@]}
    
    indent=$(printf ' %.0s' $(seq 1 ${INDENT_SIZE}))
    i=0
    while [ "${i}" -lt "${length}" ]
    do
	printf '%s%s%s\n' "${indent}" "${DESCRIPTION_TAG}" "$(printf '%s' "${descr[${i}]}" | awk '{$1=$1}1')"
	#if [ "${i}" -lt "$((${length}-1))" ]
	#then
	#    printf '\n'
	#fi
	i=$((${i}+1))
    done    
}

# print_usage command
print_usage() {
    printf '%s\n' "${USAGE_HEADER}"

    usage=$(help_${command} 'usage_examples')
    export IFS=$'\n'
    readarray -t usage <<< "${usage}"
    unset IFS
    length=${#usage[@]}
    
    indent=$(printf ' %.0s' $(seq 1 ${INDENT_SIZE}))
    i=0
    while [ "${i}" -lt "${length}" ]
    do
	printf '%s%s\n' "${indent}" "$(printf '%s' "${usage[${i}]}" | awk '{$1=$1}1')"
	i=$((${i}+1))
    done    
}

# help_command command
help_command() {
    print_frame ${FRAME_CHAR} ${FRAME_HPAD} ${FRAME_VPAD} ${HEADER_STRING}
    printf '\n'
    print_center "${1}" $((${#HEADER_STRING}+2*${HPAD}+2))
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_aliases ${1}
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_parameters ${1}
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_description ${1}
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_usage ${1}
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_args_info
    printf '\n%.0s' $(seq 1 ${VSPACING})
    print_footer
}

# help_initialize parameter
help_initialize() {
    case "${1}" in
        "vital_parameters")
	    printf '%s' \
		   ""
	    ;;
        "vital_parameters_descriptions")
	    printf '%s' \
		   ""
	    ;;
        "opt_parameters")
	    printf '%s' \
		   ""
	    ;;
        "opt_parameters_descriptions")
	    printf '%s' \
		   ""
	    ;;
        "opt_parameters_defaults")
	    printf '%s' \
		   ""
	    ;;
        "command_description")
	    printf '%s' \
		   "The 'initialize' command initializes a new instance of upm. After running the initialize command, upm will prompt the user to create a gpg password which will be used to encrypt and decrypt passwords.
		   The upm home directory will be created at \${UPM_HOME} (default $HOME/.upm_home).
		   A standalone gpg home directory will be created at \${UPM_HOME}/${GPG_HOME_DIR_NAME} to store the keys which will be used to encrypt and decrypt passwords. The gpg key ID associated to upm is stored in plaintext in \${UPM_HOME}/${GPG_KEY_ID_FILE_NAME}.
		   Passwords will be stored encrypted in \${UPM_HOME}/${PASSWORDS_DIR_NAME}. Index files used to keep track of the passwords are stored enrypted in \${UPM_HOME}/${INDEX_DIR_NAME}."
	    ;;
        "usage_examples")
	    printf '%s' \
		   "upm initialize"
	    ;;
    esac
}

# help_generate parameter
help_generate() {
    case "${1}" in
        "vital_parameters")
	    printf '%s' \
		   "scope
		   username"
	    ;;
        "vital_parameters_descriptions")
	    printf '%s' \
		   "The website, application, etc. to which the password is associated.
		   The username or account to which the password is associated."
	    ;;
        "opt_parameters")
	    printf '%s' \
		   "numchars
		   charset"
	    ;;
        "opt_parameters_descriptions")
	    printf '%s' \
		   "The number of characters of the generated password.
		   The 'tr' charset from which the password will be generated. See below for valid charsets."
	    ;;
        "opt_parameters_defaults")
	    printf '%s' \
		   "64
		   print"
	    ;;
        "command_description")
	    printf '%s' \
		   "The 'generate' command generates a random password of length <numchars> from the 'tr' character set <charset>. (see 'man tr' for a full explanation)
		   Valid character sets are:
		   .....alnum   ---all letters and digits
		   .....alpha   ---all letters
		   .....digit   ---all digits	
		   .....graph   ---all printable characters, not including space
		   .....lower   ---all lower case letters
		   .....print   ---all printable characters, including space
		   .....punct   ---all punctuation characters
		   .....upper   ---all upper case letters
		   .....xdigit  --all hexadecimal digits"
	    ;;
        "usage_examples")
	    printf '%s' \
		   "upm generate fakemail.com myaccount
		   upm generate fakemail.com myaccount 32
		   upm generate fakemail.com myaccount 16 alnum"
	    ;;
    esac
}

