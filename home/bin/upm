# help command
help() {
    if [ "${1}" == "" ]
    then
	help_general
    else
	command=$(parse_command ${1})
	if [ "${command}" == "ERROR" ]
	then
	    error "Invalid command '${1}'.
     Use 'upm help' for a list of valid commands."
	fi
	help_command ${command}
    fi
}

##############################
#                            #
#        arg parsing         #
#                            #
##############################

# check_args command num_args num_args_allowed_array
check_args() {
    # ${@:3} is all args except first and second
    # spaces allow for nargs > 9
    # otherwise e.g. could require 10 but 1 would be accepted
    if [[ ! " ${@:3} " == *" ${2} "* ]]
    then
	error "Wrong number of arguments for command '${1}'.
     Use 'upm help ${1}' for usage information."
    fi
}

##############################
#                            #
#           backup           #
#                            #
##############################

# backup backup_file
backup() {
    tar cjf ${1:-${DEFAULT_BACKUP_FILE}} -C ${HOME_DIR} .
    printf '%s\n' "Backup created at ${1:-${DEFAULT_BACKUP_FILE}}"
}

##############################
#                            #
#             load           #
#                            #
##############################

# verify_home_dir_ne backup_file
verify_home_dir_ne() {
    if [ -e "${HOME_DIR}" ]
    then
	error "upm home directory already exists at ${HOME_DIR}
     Use 'upm merge ${1}' to merge the passwords stored in ${1} into ${HOME_DIR}"
    fi
}

# load backup_file
load() {
    # set UPM_HOME before load!
    verify_home_dir_ne ${1}
    mkdir -p ${HOME_DIR}
    tar -C ${HOME_DIR} -xjf ${1}
    printf '%s\n' "Created new upm home directory at ${HOME_DIR} from backup file ${1}"
    init_lock
}

##############################
#                            #
#            merge           #
#                            #
##############################

# verify_home_dir_e backup_file
verify_home_dir_e() {
    if [ ! -e "${HOME_DIR}" ]
    then
	error "upm home directory not found at ${HOME_DIR}
     Use 'upm load ${1}' to load the backup into a new upm instance."
    fi
}

# merge_passwords tmp_home
merge_passwords() {
    tmp_gpg_recipient=$(cat "${1}/${GPG_KEY_ID_FILE_NAME}")
    tmp_gpg_home="${1}/${GPG_HOME_DIR_NAME}"
    tmp_index_dir="${1}/${INDEX_DIR_NAME}"
    tmp_password_dir="${1}/${PASSWORD_DIR_NAME}"
    for encrypted_scope in ${tmp_index_dir}/*
    do
	for encrypted_username in ${encrypted_scope}/*
	do
	    export GNUPGHOME=${tmp_gpg_home}
	    creds=$(gpg --quiet --recipient ${tmp_gpg_recipient} --decrypt ${encrypted_username})
	    scope=$(printf '%s' ${creds} | awk -F: '{print $1}')
	    username=$(printf '%s' ${creds} | awk -F: '{print $2}')
	    password=$(gpg --quiet --recipient ${tmp_gpg_recipient} --decrypt "${tmp_password_dir}/$(hash_string ${scope})/$(hash_string ${username})")
	    swap_gpg_home
	    set_gpg_recipient
	    if [ -e "${PASSWORD_DIR}/$(hash_string ${scope})/$(hash_string ${username})" ]
	    then
		printf '%s\n' "-----------------------------------------------------------"
		printf '%s\n' "Entry ${scope} ${username} already exists in current upm home directory (${HOME_DIR}). Do you want to overwrite the entry ${scope} ${username} in ${HOME_DIR} with the entry from ${1}?"
		printf '%s' "     Type 'yes' or 'no': "
		read -r "confirm"
		if [ "${confirm}" == "yes" ]
		then
		    printf '%s\n' "Replacing entry ${scope} ${username} in ${HOME_DIR} with entry ${scope} ${username} from ${1}"
		    printf '%s\n' "${password}" |
			gpg --quiet --yes --recipient ${GPG_RECIPIENT} --encrypt --output "${PASSWORD_DIR}/$(hash_string ${scope})/$(hash_string ${username})"
		else
		    printf '%s\n' "Keeping entry ${scope} ${username} from ${HOME_DIR}"
		fi
		printf '%s\n' "-----------------------------------------------------------"
	    else
		mkdir -p "${PASSWORD_DIR}/$(hash_string ${scope})"
		printf '%s\n' "${password}" |    
			gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output "${PASSWORD_DIR}/$(hash_string ${scope})/$(hash_string ${username})"
		add_to_index "${scope}" "${username}"
	    fi
	    unset password
	    unset scope
	    unset username	    
	done
    done
}

# merge_notes tmp_home
merge_notes() {
    tmp_gpg_recipient=$(cat "${1}/${GPG_KEY_ID_FILE_NAME}")
    tmp_gpg_home="${1}/${GPG_HOME_DIR_NAME}"
    tmp_note_index_dir="${1}/${NOTE_INDEX_DIR_NAME}"
    tmp_note_dir="${1}/${NOTE_DIR_NAME}"
    for title in ${tmp_note_index_dir}/*
    do
	export GNUPGHOME=${tmp_gpg_home}
	title=$(gpg --quiet --recipient ${tmp_gpg_recipient} --decrypt ${title})
	note=$(gpg --quiet --recipient ${tmp_gpg_recipient} --decrypt "${tmp_note_dir}/$(hash_string ${title})")
	swap_gpg_home
	set_gpg_recipient
	if [ -e "${NOTE_DIR}/$(hash_string ${title})" ]
	then
	    printf '%s\n' "-----------------------------------------------------------"
	    printf '%s\n' "Note ${title} already exists in current upm home directory (${HOME_DIR}). Do you want to overwrite the note ${title} in ${HOME_DIR} with the entry from ${1}?"
	    printf '%s' "     Type 'yes' or 'no': "
	    read -r "confirm"
	    if [ "${confirm}" == "yes" ]
	    then
		printf '%s\n' "Replacing note ${title} in ${HOME_DIR} with note ${title} from ${1}"
		printf '%s\n' "${note}" |
		    gpg --quiet --yes --recipient ${GPG_RECIPIENT} --encrypt --output "${NOTE_DIR}/$(hash_string ${title})"
	    else
		printf '%s\n' "Keeping note ${title} from ${HOME_DIR}"
	    fi
	    printf '%s\n' "-----------------------------------------------------------"
	else
	    printf '%s\n' "${note}" |    
		gpg --quiet --recipient ${GPG_RECIPIENT} --encrypt --output "${NOTE_DIR}/$(hash_string ${title})"
	    add_to_note_index "${title}"
	fi
	unset title
	unset note
    done
}

# merge backup_file
merge() {
    verify_home_dir_e ${1}
    tmp_home=$(mktemp -d)
    tar -C ${tmp_home} -xjf ${1}
    merge_passwords ${tmp_home}
    merge_notes ${tmp_home}
    rm -rf ${tmp_home}
}

##############################
#                            #
#         sourcecode         #
#                            #
##############################

# sourcecode
sourcecode() {
    cat realpath $0
}


##############################
#                            #
#        parse_command       #
#                            #
##############################

# parse_command command
parse_command() {
    case "${1}" in
    @(${ALIAS_CLIP}))
	command="clip"
	;;
    @(${ALIAS_SHOW}))
	command="show"
	;;
    @(${ALIAS_GENERATE}))
	command="generate"
	;;
    @(${ALIAS_ADD}))
	command="add"
	;;
    @(${ALIAS_DELETE}))
	command="delete"
	;;
    @(${ALIAS_INDEX}))
	command="index"
	;;
    @(${ALIAS_HELP}))
	command="help"
	;;
    @(${ALIAS_INITIALIZE}))
	command="initialize"
	;;
    @(${ALIAS_BACKUP}))
	command="backup"
	;;
    @(${ALIAS_LOAD}))
	command="load"
	;;
    @(${ALIAS_MERGE}))
	command="merge"
	;;
    @(${ALIAS_UNLOCK}))
	command="unlock"
	;;
    @(${ALIAS_LOCK}))
	command="lock"
	;;
    @(${ALIAS_NOTE}))
	command="note"
	;;
    @(${ALIAS_NINDEX}))
	command="nindex"
	;;
    @(${ALIAS_NDELETE}))
	command="ndelete"
	;;
    @(${ALIAS_NSHOW}))
	command="nshow"
	;;
    @(${ALIAS_RANDOM}))
	command="random"
	;;
    @(${ALIAS_SOURCECODE}))
	command="sourcecode"
	;;
    *)
	command="ERROR"
	;;
esac
printf '%s' "${command}"
}

# get_nargs command
get_nargs() {
case "${1}" in
    @(${ALIAS_CLIP}))
	num_args="3 4"
	;;
    @(${ALIAS_SHOW}))
	num_args="3"
	;;
    @(${ALIAS_GENERATE}))
	num_args="3 4 5"
	;;
    @(${ALIAS_ADD}))
	num_args="3"
	;;
    @(${ALIAS_DELETE}))
	num_args="3"
	;;
    @(${ALIAS_INDEX}))
	num_args="1"
	;;
    @(${ALIAS_HELP}))
	num_args="1 2"
	;;
    @(${ALIAS_INITIALIZE}))
	num_args="1"
	;;
    @(${ALIAS_BACKUP}))
	num_args="1 2"
	;;
    @(${ALIAS_LOAD}))
	num_args="2"
	;;
    @(${ALIAS_MERGE}))
	num_args="2"
	;;
    @(${ALIAS_UNLOCK}))
	num_args="1"
	;;
    @(${ALIAS_LOCK}))
	num_args="1"
	;;
    @(${ALIAS_NOTE}))
	num_args="2"
	;;
    @(${ALIAS_NINDEX}))
	num_args="1"
	;;
    @(${ALIAS_NDELETE}))
	num_args="2"
	;;
    @(${ALIAS_NSHOW}))
	num_args="2"
	;;
    @(${ALIAS_RANDOM}))
	num_args="1 2 3 4"
	;;
    @(${ALIAS_SOURCECODE}))
	num_args="1"
	;;
esac
printf '%s' "${num_args[@]}"
}

##############################
#                            #
#           main             #
#                            #
##############################
			   
# swap to local gpg
swap_gpg_home
# check commmand
command=$(parse_command ${1})
if [ "${command}" == "ERROR" ]
then
	error "Invalid command '${1}'.
     Use 'upm help' for a list of valid commands."
fi
nargs=($(get_nargs ${1}))
# check num args
check_args ${command} $# ${nargs[@]}
# run command
${command} ${@:2}
# revert to system gpg
revert_gpg_home

